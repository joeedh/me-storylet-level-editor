{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native-clang",
      "inherits": "native-base",
      "displayName": "clang-cl (Ninja Multi-Config)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "native-msvc",
      "inherits": "native-base",
      "displayName": "MSVC cl (Ninja Multi-Config)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    {"name": "native-clang-debug", "configurePreset": "native-clang", "configuration": "Debug"},
    {"name": "native-clang-release", "configurePreset": "native-clang", "configuration": "RelWithDebInfo"},
    {"name": "native-msvc-debug", "configurePreset": "native-msvc", "configuration": "Debug"},
    {"name": "native-msvc-release", "configurePreset": "native-msvc", "configuration": "RelWithDebInfo"}
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error", "jobs": 4}
    },
    {"name": "native-clang-debug", "inherits": "test-base", "configurePreset": "native-clang", "configuration": "Debug"},
    {"name": "native-clang-release", "inherits": "test-base", "configurePreset": "native-clang", "configuration": "RelWithDebInfo"},
    {"name": "native-msvc-debug", "inherits": "test-base", "configurePreset": "native-msvc", "configuration": "Debug"},
    {"name": "native-msvc-release", "inherits": "test-base", "configurePreset": "native-msvc", "configuration": "RelWithDebInfo"}
  ]
}
